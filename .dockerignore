# Allowlist: nothing else (including hidden files/credentials) reaches the daemon.
**
!Dockerfile
!.dockerignore
!renv.lock
!.here
!docker/
!docker/**
!day1/
!day2/
!day3/
!day1/*.qmd
!day2/*.qmd
!day3/*.qmd
!R/
!R/course_data.R
!R/course_utils.R
!R/functions.R
!R/slides_setup.R
!R/classroom_materials.R
!R/build_classroom_materials.R
!classroom/
!classroom/readiness.qmd
!classroom/instructor.md
!stan/
!stan/*.stan
!fits/
!fits/day1_seedling.rds
!fits/day2_allo.rds
!fits/day2_allo_bad.rds
!fits/day2_ndd.rds
!fits/day3_trees.rds
!fits/day3_vint.rds
!fits/day3_vslope.rds
!fits/sessionInfo.txt
!images/
!images/*.png
!images/*.jpg
!images/*.gif
!assets/
!assets/custom.css
!assets/rladies.scss
!assets/fontawesome-free-6.1.1-web/
!assets/fontawesome-free-6.1.1-web/LICENSE.txt
!assets/fontawesome-free-6.1.1-web/css/
!assets/fontawesome-free-6.1.1-web/css/*.min.css
!assets/fontawesome-free-6.1.1-web/js/
!assets/fontawesome-free-6.1.1-web/js/*.min.js
!assets/fontawesome-free-6.1.1-web/webfonts/
!assets/fontawesome-free-6.1.1-web/webfonts/*.woff2
# Defense in depth, including anything accidentally added under docker/.
**/.git
**/.DS_Store
**/.env*
**/*.env
**/.afec-credentials
**/.Renviron*
**/*.key
**/*.pem
**/*secret*
**/*password*
**/__pycache__
